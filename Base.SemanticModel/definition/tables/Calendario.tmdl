table Calendario
	lineageTag: c25e1d2a-4f49-4e41-bb0e-fb02ea0f643d
	dataCategory: Time

	measure 'Mostrar Mes Transcurrido' =
			
			VAR ModoSeleccionado =
			    SELECTEDVALUE('Modo Comparación'[Modo], "No")
			VAR AnioSeleccionado =
			    SELECTEDVALUE(Calendario[Año])
			VAR MesEvaluado =
			    SELECTEDVALUE(Calendario[Mes Numero])
			RETURN
			IF(
			    ModoSeleccionado = "Si"
			        && AnioSeleccionado = YEAR(TODAY())
			        && MesEvaluado > MONTH(TODAY()),
			    0,
			    1
			)
		formatString: 0
		lineageTag: bc3232f6-32b1-494c-8a80-e0377103029f

	measure 'Mostrar Dia Transcurrido' =
			
			VAR ModoSeleccionado =
			    SELECTEDVALUE('Modo Comparación'[Modo], "No")
			VAR AnioSeleccionado =
			    SELECTEDVALUE(Calendario[Año])
			VAR MesSeleccionado =
			    SELECTEDVALUE(Calendario[Mes Numero])
			VAR DiaEvaluado =
			    SELECTEDVALUE(Calendario[Dia])
			RETURN
			IF(
			    ModoSeleccionado = "Si"
			        && AnioSeleccionado = YEAR(TODAY())
			        && MesSeleccionado = MONTH(TODAY())
			        && DiaEvaluado > DAY(TODAY()),
			    0,
			    1
			)
		formatString: 0
		lineageTag: 554e7279-8f09-4e90-aa8d-6447ce8dffad

	measure 'Modo Comparación' =
			
			DATATABLE(
			    "Modo", STRING,
			    {
			        {"No"},
			        {"Si"}
			    }
			)
		lineageTag: 58457be5-b032-480b-8459-79eb63a2de89

