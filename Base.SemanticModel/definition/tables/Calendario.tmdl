	column 'Es Fin Semana'
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 5f73d341-adea-4697-a626-a7aec2a2c909
		summarizeBy: none
		isNameInferred
		sourceColumn: [Es Fin Semana]

		annotation SummarizationSetBy = Automatic

	column 'Es Mes Transcurrido' =
			
			IF(
			    YEAR(Calendario[Date]) < YEAR(TODAY())
			        ||
			    (
			        YEAR(Calendario[Date]) = YEAR(TODAY())
			            && MONTH(Calendario[Date]) <= MONTH(TODAY())
			    ),
			    1,
			    0
			)
		formatString: 0
		lineageTag: b437f346-49e1-47c7-85f6-be6a16e479e6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Es Dia Transcurrido' =
			
			IF(
			    Calendario[Date] <= TODAY(),
			    1,
			    0
			)
		formatString: 0
		lineageTag: f3d4aa3b-864d-4d01-b616-1e1159ce8948
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Trimestre Numero'
		formatString: 0
		lineageTag: 1a5437e3-d36a-4c70-b192-17ca24aa9b86
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Trimestre Numero]

		annotation SummarizationSetBy = Automatic

	column 'AñoMes Orden'
		formatString: 0
		lineageTag: 497618bc-ebe1-4426-ae21-0f8c1aa15368
		summarizeBy: sum
		isNameInferred
		sourceColumn: [AñoMes Orden]

		annotation SummarizationSetBy = Automatic

	column 'AñoTrimestre Orden'
		formatString: 0
		lineageTag: 84e88fed-b562-44bc-8798-ae6a925625b8
		summarizeBy: sum
		isNameInferred
		sourceColumn: [AñoTrimestre Orden]

		annotation SummarizationSetBy = Automatic

	column SemanaVisual =
			
			VAR InicioSemana =
			    Calendario[Date]
			    - WEEKDAY(Calendario[Date], 2)
			    + 1
			
			VAR FinSemana =
			    InicioSemana + 6
			
			RETURN
			FORMAT(YEAR(InicioSemana), "0000")
			& "-S"
			& FORMAT(Calendario[Semana Año], "00")
			& " ("
			& FORMAT(InicioSemana, "dd/MM")
			& "-"
			& FORMAT(FinSemana, "dd/MM")
			& ")"
		lineageTag: 54183790-c964-433f-8e5b-ba4c6a94aef9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	hierarchy 'AñoTrimestre Jerarquía'
		lineageTag: a9ff0a4a-825a-489f-90df-d6f8673c4ce2

		level AñoTrimestre
			lineageTag: b69d61a5-496c-41af-8e33-c8224d376803
			column: AñoTrimestre

		level AñoMes
			lineageTag: 857b4d85-2965-426a-9a19-01338550f8e0
			column: AñoMes

		level SemanaVisual
			lineageTag: 8c6293b9-0b63-4bc7-ac38-49b39c15bcd9
			column: SemanaVisual

	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(2024,1,1),
				        DATE(2030,12,31)
				    ),
				
				    "Año", YEAR([Date]),
				
				    "Mes Numero", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "Mes Corto", FORMAT([Date], "MMM"),
				
				    "Trimestre Numero", QUARTER([Date]),
				    "Trimestre", "T" & QUARTER([Date]),
				
				    "AñoMes", YEAR([Date]) & "-" & FORMAT(MONTH([Date]), "00"),
				    "AñoMes Orden", YEAR([Date]) * 100 + MONTH([Date]),
				
				    "AñoTrimestre", YEAR([Date]) & "-T" & QUARTER([Date]),
				    "AñoTrimestre Orden", YEAR([Date]) * 10 + QUARTER([Date]),
				
				    "Dia", DAY([Date]),
				
				    "DiaSemana Numero", WEEKDAY([Date], 2),
				    "DiaSemana", FORMAT([Date], "dddd"),
				    "DiaSemana Corto", FORMAT([Date], "ddd"),
				
				    "Semana Año", WEEKNUM([Date], 2),
				
				    "Es Fin Semana",
				        WEEKDAY([Date], 2) >= 6
				)

	annotation PBI_Id = 9ac45c888ad949e29a83354ca7ff4a6f

