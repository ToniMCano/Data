	partition LineasComisionesDadas = m
		mode: import
		source =
				let
				    Origen = Sql.Database("192.168.0.10", "dat1", [Query="SELECT#(lf)    LCD.*,#(lf)    CD.fecha AS fechaComision,#(lf)    CONCAT(LCD.idSFac, '-', LCD.idFac) AS FacturaKey#(lf)FROM lineasComisionesDadas LCD#(lf)LEFT JOIN comisionesDadas CD#(lf)    ON LCD.idComision = CD.idComision;"])
				in
				    Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

