	partition LineasComisionesDadasCobros = m
		mode: import
		source =
				let
				    Origen = Sql.Database("192.168.0.10", "dat1", [Query="SELECT#(lf)    LCC.*,#(lf)    CD.fecha AS fechaComision,#(lf)    CONCAT(LCC.idSFac, '-', LCC.idFac) AS FacturaKey#(lf)FROM lineasComisionesDadasCobros LCC#(lf)LEFT JOIN comisionesDadas CD#(lf)    ON LCC.idComision = CD.idComision;"])
				in
				    Origen

