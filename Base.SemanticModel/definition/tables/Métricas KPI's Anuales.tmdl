			    FILTER (
			        VALUES ( Clientes[nomCom] ),
			
			        VAR Nombre =
			            Clientes[nomCom]
			
			        VAR FactCliAA =
			            [(KPIs)  Ventas Netas nomCom AA]
			
			        VAR FactActual =
			            [Ventas Netas ERP]
			
			        VAR Alta =
			            CALCULATE (
			                MIN ( Clientes[fechaAlta] )
			            )
			
			        VAR EsGrupoB =
			            FactCliAA >= 3000
			                || Alta >= DATE ( 2026, 1, 1 )
			
			        RETURN
			            EsGrupoB
			            && NOT ISBLANK ( FactActual )
			            && FactActual > 0
			            && NOT ISBLANK ( Nombre )
			            && TRIM ( Nombre ) <> ""
			            && NOT CONTAINSSTRING ( Nombre, "(NNN)" )
