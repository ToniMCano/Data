	measure '(KPIs) % Clientes Grupo A' =
			
			VAR GrupoA =
			    [(KPIs) Clientes Grupo A]
			
			VAR GrupoB =
			    [(KPIs) Clientes Grupo B]
			
			RETURN
			    DIVIDE (
			        GrupoA,
			        GrupoA + GrupoB
			    )
