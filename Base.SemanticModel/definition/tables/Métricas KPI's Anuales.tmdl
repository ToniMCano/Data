	measure '(KPIs) Facturación Grupo B' =
			
			SUMX (
			    FILTER (
			        VALUES ( Clientes[nomCom] ),
			
			        VAR Nombre =
			            Clientes[nomCom]
			
			        VAR FactCliAA =
			            [(KPIs)  Ventas Netas nomCom AA]
			
			        VAR FactActual =
			            [Ventas Netas ERP]
			
			        VAR Alta =
			            CALCULATE (
			                MIN ( Clientes[fechaAlta] )
			            )
			
			        VAR EsBHistorico =
			            FactCliAA >= 3000
			                && (
			                    ISBLANK ( Alta )
			                        || Alta < DATE ( 2026, 1, 1 )
			                )
			
			        VAR EsBNuevo =
			            Alta >= DATE ( 2026, 1, 1 )
			                && (
			                    ISBLANK ( FactCliAA )
			                        || FactCliAA = 0
			                )
			
			        RETURN
			            ( EsBHistorico || EsBNuevo )
			            && NOT ISBLANK ( FactActual )
			            && FactActual > 0
			            && NOT ISBLANK ( Nombre )
			            && TRIM ( Nombre ) <> ""
			            && NOT CONTAINSSTRING ( Nombre, "(NNN)" )
			            && NOT CONTAINSSTRING ( Nombre, "(NO)" )
			            && NOT CONTAINSSTRING ( Nombre, "(N)" )
			            && NOT CONTAINSSTRING ( Nombre, "COTIZACION" )
			    ),
			    [Ventas Netas ERP]
			)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 7c28d09f-8a87-42b1-a0ae-5d592a9ff021

