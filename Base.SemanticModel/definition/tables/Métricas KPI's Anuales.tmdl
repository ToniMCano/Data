table 'Métricas KPI''s Anuales'
	lineageTag: 7ec6add2-37f7-4535-8902-9552bcefa3c5

	measure '(KPIs) Clientes Activos Grupo A' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( Clientes[nomCom] ),
			
			        VAR Nombre =
			            Clientes[nomCom]
			
			        VAR FactCliAA =
			            [(KPIs)  Ventas Netas nomCom AA]
			
			        VAR FactActual =
			            [Ventas Netas ERP]
			
			        VAR Alta =
			            CALCULATE (
			                MIN ( Clientes[fechaAlta] )
			            )
			
			        RETURN
			            (
			                ISBLANK ( FactCliAA )
			                    || FactCliAA < 3000
			            )
			            && (
			                ISBLANK ( Alta )
			                    || Alta < DATE ( 2026, 1, 1 )
			            )
			            && NOT ISBLANK ( FactActual )
			            && FactActual > 0
			            && NOT ISBLANK ( Nombre )
			            && TRIM ( Nombre ) <> ""
			            && NOT CONTAINSSTRING ( Nombre, "(NNN)" )
			            && NOT CONTAINSSTRING ( Nombre, "(NO)" )
			            && NOT CONTAINSSTRING ( Nombre, "(N)" )
			            && NOT CONTAINSSTRING ( Nombre, "(NO )" )
			            && NOT CONTAINSSTRING ( Nombre, "( NO)" )
			            && NOT CONTAINSSTRING ( Nombre, "( N )" )
			            && NOT CONTAINSSTRING ( Nombre, "COTIZACION" )
			    )
			)
		formatString: 0
		lineageTag: 59a21ec2-2efe-49b2-acee-f06da6a0f0d8

	measure '(KPIs)  Ventas Netas nomCom AA' = ```
			
			    CALCULATE(
			        [Ventas Netas LY],
			        ALLEXCEPT(Clientes, Clientes[nomCom])
			    )
			
			```
		lineageTag: 72e0f204-9d7e-43fe-aace-9547af6e58d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '(KPIs) Clientes Grupo A 2025' =
			
			COUNTROWS (
			    FILTER (
			        SUMMARIZE (
			            Clientes,
			            Clientes[idCliente],
			            Clientes[nomCom],
			            Clientes[idEmpleado],
			            "FactCli", [(KPIs)  Ventas Netas nomCom AA]
			        ),
			        VAR Facturacion = [FactCli]
			        VAR Nombre = [nomCom]
			        VAR Empleado = Clientes[idEmpleado]
			
			        RETURN
			            (
			                ISBLANK ( Facturacion )
			                    || Facturacion < 3000
			            )
			            && NOT ISBLANK ( Nombre )
			            && TRIM ( Nombre ) <> ""
			            && NOT Empleado IN {
			                168, 140, 123, 99, 73, 65, 30, 26,
			                24, 23, 15, 10, 2, 1, 0
			            }
			            && NOT CONTAINSSTRING ( Nombre, "(NNN)" )
			            && NOT CONTAINSSTRING ( Nombre, "(NO)" )
			            && NOT CONTAINSSTRING ( Nombre, "(N)" )
			            && NOT CONTAINSSTRING ( Nombre, "(NO )" )
			            && NOT CONTAINSSTRING ( Nombre, "( NO)" )
			            && NOT CONTAINSSTRING ( Nombre, "( N )" )
			    )
			)
		formatString: 0
		lineageTag: cabcddaf-5ffb-4da3-9f7b-1144f947c406

