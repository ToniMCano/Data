table 'Métricas KPI''s Anuales'
	lineageTag: 7ec6add2-37f7-4535-8902-9552bcefa3c5

	measure '(KPIs) Clientes Activos Grupo A' = ```
			
			
			
			COUNTROWS (
			    FILTER (
			        SUMMARIZE (
			            Clientes,
			            Clientes[idCliente],
			            Clientes[nomCom],
			            Clientes[idEmpleado],
			            "Dif", [YoY Netas %],
			            "FactCliAA", [(KPIs)  Facturación Cliente < 3000 AA],
			            "FactActual", [Ventas Netas ERP]
			        ),
			        [FactCliAA] > 0
			            && [FactCliAA] < 3000
			            && [FactActual] > 0
			            && NOT ISBLANK ( [nomCom] )
			            && TRIM ( [nomCom] ) <> ""
			            && Clientes[idEmpleado] <> 168 
			            && Clientes[idEmpleado] <> 140 
			            && Clientes[idEmpleado] <> 123 
			            && Clientes[idEmpleado] <> 99 
			            && Clientes[idEmpleado] <> 73 
			            && Clientes[idEmpleado] <> 65 
			            && Clientes[idEmpleado] <> 30 
			            && Clientes[idEmpleado] <> 26 
			            && Clientes[idEmpleado] <> 24 
			            && Clientes[idEmpleado] <> 23 
			            && Clientes[idEmpleado] <> 15 
			            && Clientes[idEmpleado] <> 10 
			            && Clientes[idEmpleado] <> 2 
			            && Clientes[idEmpleado] <> 1 
			            && Clientes[idEmpleado] <> 0
			            && NOT ( CONTAINSSTRING ( [nomCom], "(NO)" ) )
			            && NOT ( CONTAINSSTRING ( [nomCom], "(N)" ) )
			            && NOT ( CONTAINSSTRING ( [nomCom], "(NO )" ) )
			            && NOT ( CONTAINSSTRING ( [nomCom], "( NO)" ) )
			            && NOT ( CONTAINSSTRING ( [nomCom], "( N )" ) )
			    )
			)
			```
		formatString: 0
		lineageTag: 59a21ec2-2efe-49b2-acee-f06da6a0f0d8

	measure '(KPIs)  Facturación Cliente < 3000 AA' = ```
			
			    CALCULATE(
