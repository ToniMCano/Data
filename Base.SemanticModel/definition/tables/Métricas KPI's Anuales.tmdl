	measure '(KPIs)  Incremento' = 180000
		formatString: 0
		lineageTag: fb17f6c1-b3d1-4487-9170-8afac33a340d

	measure '(KPIs)  Incremento Grupo A' =
			
			
			
			
			VAR facturacionB = ([Ventas Netas LY] - [(KPIs)  Facturación Grupo A 2025 (AA)]) * 0.04
			
			VAR incremento = ([(KPIs)  Incremento] * [(KPIs)  Multiplicador Comerciales]) - facturacionB
			
			RETURN incremento
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 28273b52-d235-4755-9604-bf100ffebd3b

	measure '(KPIs)  Facturación Grupo A 2025 (AA)' = ```
			
			CALCULATE(
			    [Ventas Netas LY],
			    FILTER(
			        Clientes,
			        [(KPIs)  Facturación Cliente < 3000 AA] < 3000 && [(KPIs)  Facturación Cliente < 3000 AA] > 0 
			            && NOT CONTAINSSTRING( Clientes[nomCom], "(NO)" )
			                && NOT CONTAINSSTRING( Clientes[nomCom], "(N)" )
			                && NOT CONTAINSSTRING( Clientes[nomCom], "(NO )" )
			                && NOT CONTAINSSTRING( Clientes[nomCom], "( NO)" )
			                && NOT CONTAINSSTRING( Clientes[nomCom], "( N )" )
			                && NOT CONTAINSSTRING ( [nomCom], "(NNN)" )
			                && Clientes[idEmpleado] <> 168
			                && Clientes[idEmpleado] <> 140
			                && Clientes[idEmpleado] <> 123
			                && Clientes[idEmpleado] <> 99
			                && Clientes[idEmpleado] <> 73
			                && Clientes[idEmpleado] <> 65
			                && Clientes[idEmpleado] <> 30
			                && Clientes[idEmpleado] <> 26
			                && Clientes[idEmpleado] <> 24
			                && Clientes[idEmpleado] <> 23
			                && Clientes[idEmpleado] <> 15
			                && Clientes[idEmpleado] <> 10
			                && Clientes[idEmpleado] <> 2      
			                && Clientes[idEmpleado] <> 1
			    )
			)
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 9fc6fd9c-f615-4bc3-b017-b080d7835b6d

	measure '(KPIs)  Multiplicador Comerciales' = ```
			
			
