	measure '(KPIs) Clientes Grupo A' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( Clientes[nomCom] ),
			
			        VAR Nombre =
			            Clientes[nomCom]
			
			        VAR FactCliAA =
			            [(KPIs)  Ventas Netas nomCom AA]
			
			        VAR Alta =
			            CALCULATE (
			                MIN ( Clientes[fechaAlta] )
			            )
			
			        RETURN
			            (
			                ISBLANK ( FactCliAA )
			                    || FactCliAA < 3000
			            )
			            && (
			                ISBLANK ( Alta )
			                    || Alta < DATE ( 2026, 1, 1 )
			            )
			            && NOT ISBLANK ( Nombre )
			            && TRIM ( Nombre ) <> ""
			            && NOT CONTAINSSTRING ( Nombre, "(NNN)" )
			            && NOT CONTAINSSTRING ( Nombre, "(NO)" )
			            && NOT CONTAINSSTRING ( Nombre, "(N)" )
			            && NOT CONTAINSSTRING ( Nombre, "(NO )" )
			            && NOT CONTAINSSTRING ( Nombre, "( NO)" )
			            && NOT CONTAINSSTRING ( Nombre, "( N )" )
			            && NOT CONTAINSSTRING ( Nombre, "COTIZACION" )
			    )
			)
		formatString: 0
		lineageTag: b34f2102-c9a9-48d3-810d-901db19b7e2b

	measure '(KPIs) % Clientes Grupo B 2025' =
			
			VAR GrupoA =
			    [(KPIs) Clientes Grupo A]
			
			VAR GrupoB =
			    [(KPIs) Clientes Grupo B 2025]
			
			RETURN
			    DIVIDE (
			        GrupoB,
			        GrupoA + GrupoB
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1c9eaa66-4a9c-4cb2-bf8a-9f51a0479f4c

	measure '(KPIs) % Clientes Grupo B' =
			
			VAR GrupoA =
			    [(KPIs) Clientes Grupo A]
			
			VAR GrupoB =
			    [(KPIs) Clientes Grupo B]
			
			RETURN
			    DIVIDE (
			        GrupoB,
			        GrupoA + GrupoB
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: e8daa0a2-8f5a-4647-9fb7-226e60d0b11d

	measure '(KPIs) Grupo Cliente' =
			
			VAR Alta =
			    MAX ( Clientes[fechaAlta] )
			
			VAR FacturacionAA =
			    [Ventas Netas LY]
			
			RETURN
			SWITCH (
			    TRUE(),
			
			    Alta >= DATE ( 2026, 1, 1 ),
			        "C",
			
			    ISBLANK ( FacturacionAA ) || FacturacionAA < 3000,
			        "A",
			
			    FacturacionAA >= 3000,
			        "B",
			
			    BLANK()
			)
		lineageTag: b978cfce-aadb-4a20-ae3b-bad1e8358e53

	measure '(KPIs) Grupo A Crecimiento' =
			
			VAR FacturacionAA =
			    [(KPIs)  Ventas Netas nomCom AA]
			
			VAR FacturacionActual =
			    [Ventas Netas ERP]
			
			RETURN
			    IF (
			 NOT ISBLANK ( FacturacionActual )
			            && FacturacionActual > 0
			            && FacturacionActual > COALESCE ( FacturacionAA, 0 ),
			        1,
			        BLANK()
			    )
		formatString: 0
		lineageTag: 5276652c-8fd0-4830-a81b-b53d3ad6ed5b

