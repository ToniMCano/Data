	measure 'Último Precio Cliente Referencia' =
			
			VAR ClienteActual =
			    SELECTEDVALUE(FactVentas[idCliente])
			
			VAR ReferenciaActual =
			    SELECTEDVALUE(FactVentas[referencia])
			
			VAR UltimaLinea =
			    TOPN(
			        1,
			        FILTER(
			            ALL(FactVentas),
			            FactVentas[idCliente] = ClienteActual
			                && FactVentas[referencia] = ReferenciaActual
			        ),
			        FactVentas[fechaAlb], DESC,
			        FactVentas[idAlb], DESC,
			        FactVentas[numLinea], DESC
			    )
			
			RETURN
			    MAXX(
			        UltimaLinea,
			        FactVentas[precio]
			    )
		lineageTag: b0e5da12-ca31-45cd-8cec-8777a661857f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Frecuencia Compra Días' =
			
			VAR FechasCompra =
			    CALCULATETABLE(
			        VALUES(FactVentas[fechaAlb]),
			        FactVentas[fechaAlb] <> BLANK()
			    )
			
			VAR FechasConAnterior =
			    ADDCOLUMNS(
			        FechasCompra,
			        "FechaAnterior",
			            VAR FechaActual = FactVentas[fechaAlb]
			            RETURN
			                MAXX(
			                    FILTER(
			                        FechasCompra,
			                        FactVentas[fechaAlb] < FechaActual
			                    ),
			                    FactVentas[fechaAlb]
			                )
			    )
			
			RETURN
			    AVERAGEX(
			        FILTER(
			            FechasConAnterior,
			            [FechaAnterior] <> BLANK()
			        ),
			        DATEDIFF([FechaAnterior], FactVentas[fechaAlb], DAY)
			    )
		lineageTag: e7473f02-8e54-498d-95b2-3e7c0d55e49b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Próxima Compra Estimada' =
			
			VAR UltimaCompra =
			    MAX(FactVentas[fechaAlb])
			
			VAR Frecuencia =
			    [Frecuencia Compra Días]
			
			RETURN
			    IF(
			        NOT ISBLANK(Frecuencia),
			        UltimaCompra + Frecuencia
			    )
		formatString: Short Date
		lineageTag: ae4cc354-870d-40ec-a705-abab436c9884

	measure 'Indicador Compra' =
			
			
			VAR FechaUltimoAlbaran =
			    MAX(FactVentas[fechaAlb])
			
			RETURN
			    DATEDIFF(
			        FechaUltimoAlbaran,
			        TODAY(),
			        DAY
			    )
		formatString: 0
		lineageTag: 115d0849-1dd6-4036-b084-5da3f2143ce5

	measure '% Estado Venta' =
			
			VAR Frecuencia = [Frecuencia Compra Días]
