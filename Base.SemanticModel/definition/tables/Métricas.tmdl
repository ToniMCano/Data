	measure 'Clientes en Positivo' = [Clientes Activos] - [Clientes en Caída]
		formatString: 0
		lineageTag: 3978692f-7de0-4bdd-858d-d2ae05e85d3d

	measure 'Clientes en Caída AA' =
			
			
			VAR ModoSeleccionado =
			    SELECTEDVALUE(
			        'Modo Comparación'[Modo],
			        "No"
			    )
			
			VAR FechaMinSeleccionada =
			    MIN(Calendario[Date])
			
			VAR FechaMaxSeleccionada =
			    MAX(Calendario[Date])
			
			VAR FechaMaxActualLimitada =
			    MIN(
			        FechaMaxSeleccionada,
			        TODAY()
			    )
			
			VAR FechaInicioAA =
			    EDATE(FechaMinSeleccionada, -12)
			
			VAR FechaFinAA =
			    EDATE(FechaMaxActualLimitada, -12)
			
			VAR AnioAnterior =
			    YEAR(FechaMaxActualLimitada) - 1
			
			RETURN
			SWITCH(
			    ModoSeleccionado,
			
			    "Si",
			        CALCULATE(
			            [Clientes en Caída],
			            DATESBETWEEN(
			                Calendario[Date],
			                FechaInicioAA,
			                FechaFinAA
			            )
			        ),
			
			    "No",
			        CALCULATE(
			            [Clientes en Caída],
			            FILTER(
			                ALL(Calendario),
			                YEAR(Calendario[Date]) = AnioAnterior
			            )
			        )
			)
		formatString: 0
		lineageTag: f84f4f69-4dbe-420e-8ccb-50807e379d4e

	measure 'Clientes en Positivo AA' =
			
			
			VAR ModoSeleccionado =
