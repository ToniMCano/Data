	measure 'Clientes en Caída' = ```
			
			CALCULATE (
			    COUNTROWS (
			        FILTER (
			            VALUES ( Clientes[idCliente] ),
			            [Dif. AA Importe] < 0
			        )
			    ),
			    NOT ISBLANK ( Clientes[nomCom] ),
			    TRIM ( Clientes[nomCom] ) <> "",
			    
			    NOT CONTAINSSTRING ( Clientes[nomCom], "(NO)" ),
			    NOT CONTAINSSTRING ( Clientes[nomCom], "(N)" ),
			    NOT CONTAINSSTRING ( Clientes[nomCom], "(NO )" ),
			    NOT CONTAINSSTRING ( Clientes[nomCom], "( NO)" ),
			    NOT CONTAINSSTRING ( Clientes[nomCom], "( N )" )
			)
