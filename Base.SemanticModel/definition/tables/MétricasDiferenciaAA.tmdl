	measure 'Ventas Brutas Diferencia Importe KPI' =
			
			
			VAR Variacion = DIVIDE([Ventas Brutas (Sin Dtos)] - [Ventas Brutas AA (Sin Dto)],[Ventas Brutas AA (Sin Dto)])
			
