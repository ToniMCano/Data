table MétricasDiferenciaAA
	lineageTag: 3d4975fc-a8c7-4897-9ef4-0a2fc642606f

	measure 'YoY Netas %' =
			
			DIVIDE(
			    [Ventas Netas ERP] - [Ventas Netas LY],
			    [Ventas Netas LY]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 2b717c2e-6597-42fc-8b0d-75ce850ebd5e

	measure 'Kilos %' =
			
			VAR Actual = [Kilos]
			VAR LY = [Kilos LY Dinámico]
			
			RETURN
			DIVIDE(Actual - LY, LY)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 58831c65-04d4-47f7-b0d4-1fb2220ef83e

	measure 'Unidades %' =
			
			DIVIDE(
			    [Unidades] - 'MétricasVentasAA'[Unidades LY Dinámico],
			    'MétricasVentasAA'[Unidades LY Dinámico]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: e3956103-0dd9-41bb-bfb3-659fad7145ab

	measure DifUnidadesAA =
			
			[Unidades] - [Unidades LY Dinámico]
		lineageTag: 5bddc4f4-039a-462e-8c81-bfb67e6185ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DifKilosAA =
			
			[Kilos] - [Kilos LY Dinámico]
		lineageTag: 80443e5d-378e-443a-9727-d4569b44e269

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dif. AA Importe' =
			
			[DtoAlbAplicado Final] - 'MétricasVentasAA'[Ventas Netas LY]
		lineageTag: 99fe7947-e88d-41a5-bdf1-7baa3cabdc69

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dif. AA Cajas' =
			
			[Cajas] - 'MétricasVentasAA'[Cajas LY Dinámico]
		lineageTag: 540a0898-5e34-4ef0-a1ff-5ac5e4b33fd0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cajas %' =
			
			VAR Actual = [Cajas]
			VAR LY = [Cajas LY Dinámico]
			
			RETURN
			DIVIDE(Actual - LY, LY)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: ec946c87-bbff-455b-96fb-5345c531a383

	measure 'Media Albaranes VS AA' = [Media Albarán]- [Media Albarán AA]
		formatString: 0
		lineageTag: 64518e0a-e165-48a1-8b35-482c4873ff6d

	measure 'Dif. AB' =
			
			[AB] - [AB - AA]
		formatString: 0
		lineageTag: e0118a3a-2987-4253-807d-3fd89715a440

	measure 'Dif. V' =
			
			[V] - [V - AA]
		formatString: 0
		lineageTag: 8700ee9d-607f-4d67-a4fc-7726a36e3343

	measure 'Dif. IN' =
			
			[IN] - [IN - AA]
		formatString: 0
		lineageTag: 17f3a96a-c0b5-44bb-adf0-fe0b3db3f857

	measure 'Dif. MU' =
			
			[MU] - [MU - AA]
		formatString: 0
		lineageTag: 17cc9108-0aa9-4cab-a380-7048de4e8f89

	measure 'Diferencia Negativa Clientes' = ```
			
			CALCULATE( 
			    SUMX( 
			        VALUES(Clientes[idCliente]), 
			        MIN([Dif. AA Importe], 0) ),
			        NOT ISBLANK(Clientes[nomCom]), 
			        TRIM(Clientes[nomCom]) <> "", 
			        
			        NOT CONTAINSSTRING ( Clientes[nomCom], "(NO)" ) 
			        && NOT CONTAINSSTRING ( Clientes[nomCom], "(N)" ) 
			        && NOT CONTAINSSTRING ( Clientes[nomCom], "(NO )" ) 
			        && NOT CONTAINSSTRING (Clientes[nomCom], "( NO)" ) 
			        && NOT CONTAINSSTRING ( Clientes[nomCom], "( N )" ) )
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 9e8c455d-1b41-4a97-8955-5dc3c7c7c35e

	measure 'Diferencia Productos Negativo' = ```
			
			CALCULATE(
			    SUMX(
			        VALUES(Productos[Referencia]),
			        MIN([Dif. AA Importe], 0)
			    ),
			    NOT CONTAINSSTRING(Productos[descrip], "(NNN)"),
			    NOT CONTAINSSTRING(Productos[descrip], "(N)")
			)
			
			
			```
		lineageTag: 2fef0fa6-9460-44a1-b5be-be8d40b83216

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas Netas Diferencia Importe KPI' =
			
			
			VAR Variacion = [YoY Netas %]
			
			RETURN
			    FORMAT([Ventas Netas ERP] - [Ventas Netas LY], "#,##0.00")
			    & " "
			    & SWITCH(
			        TRUE(),
			        Variacion > 0, "▲",
			        Variacion < 0, "▼",
			        "="
			    )
		lineageTag: 0baff3d9-bed4-469c-a10e-0ec9823795aa

	measure 'Ventas Diferencia Cajas AA KPI' =
			
			VAR Cajas = [Cajas]
			VAR CajaAA = [Cajas LY Dinámico]
			VAR Diferencia = Cajas - CajaAA
			VAR Variacion = DIVIDE(Diferencia, CajaAA)
			RETURN
			    FORMAT(Diferencia,"#,##0.00")
			    & " "
			    & SWITCH(
			        TRUE(),
			        Variacion > 0, "▲",
			        Variacion < 0, "▼",
			        "="
			    )
		lineageTag: 0f88e4b5-8426-4aaf-8616-eaceeb9090bf

	measure 'Ventas Diferencia Kilos AA KPI' =
			
			VAR Kilos = [Kilos]
			VAR KilosAA = [Kilos LY Dinámico]
			VAR Diferencia = Kilos - KilosAA
			VAR Variacion = DIVIDE(Diferencia, KilosAA)
