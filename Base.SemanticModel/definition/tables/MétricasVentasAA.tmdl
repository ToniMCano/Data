	measure 'Dto. Factura AA' =
			
			VAR ModoSeleccionado =
			    SELECTEDVALUE(
			        'Modo Comparación'[Modo],
			        "No"
			    )
			
			VAR FechaMinContexto =
			    MIN(Calendario[Date])
			
			VAR FechaMaxContexto =
			    MAX(Calendario[Date])
			
			VAR FechaMaxLimitada =
			    MIN(
			        FechaMaxContexto,
			        TODAY()
			    )
			
			VAR EsPeriodoFuturo =
			    FechaMinContexto > TODAY()
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    ModoSeleccionado = "Si" && EsPeriodoFuturo,
			        BLANK(),
			
			    ModoSeleccionado = "Si",
			        CALCULATE(
			            [Dto Factura Único],
			            DATESBETWEEN(
			                Calendario[Date],
			                EDATE(FechaMinContexto, -12),
			                EDATE(FechaMaxLimitada, -12)
			            )
			        ),
			
			    ModoSeleccionado = "No",
			        CALCULATE(
			            [Dto Factura Único],
			            DATEADD(
			                Calendario[Date],
			                -1,
			                YEAR
			            )
			        )
			)
		lineageTag: da3cdb8a-6e81-4a57-9194-5622afb373f6

