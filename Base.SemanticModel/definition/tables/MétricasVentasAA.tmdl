table MétricasVentasAA
	lineageTag: d55ea3bd-8ea5-408f-8912-540ef3bcb31a

	measure 'Cajas LY Dinámico' =
			
			
			VAR ModoSeleccionado =
			    SELECTEDVALUE(
			        'Modo Comparación'[Modo],
			        "No"
			    )
			
			VAR FechaMinSeleccionada =
			    MIN(Calendario[Date])
			
			VAR FechaMaxSeleccionada =
			    MAX(Calendario[Date])
			
			VAR FechaMaxActualLimitada =
			    MIN(
			        FechaMaxSeleccionada,
			        TODAY()
			    )
			
			VAR FechaInicioAA =
			    EDATE(FechaMinSeleccionada, -12)
			
			VAR FechaFinAA =
			    EDATE(FechaMaxActualLimitada, -12)
			
			VAR AnioAnterior =
			    YEAR(FechaMaxActualLimitada) - 1
			
			RETURN
			SWITCH(
			    ModoSeleccionado,
			
			    "Si",
			        CALCULATE(
			            [Cajas],
			            DATESBETWEEN(
			                Calendario[Date],
			                FechaInicioAA,
			                FechaFinAA
			            )
			        ),
			
			    "No",
			        CALCULATE(
			            [Cajas],
			            FILTER(
			                ALL(Calendario),
			                YEAR(Calendario[Date]) = AnioAnterior
			            )
			        )
			)
		lineageTag: 85a5c9d0-2364-412e-8fab-b0e3c9e83e8d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas Netas LY' =
			
			VAR ModoSeleccionado =
			    SELECTEDVALUE(
			        'Modo Comparación'[Modo],
			        "No"
			    )
			
			VAR FechaMinContexto =
			    MIN(Calendario[Date])
			
			VAR FechaMaxContexto =
			    MAX(Calendario[Date])
			
			VAR FechaMaxLimitada =
			    MIN(
			        FechaMaxContexto,
			        TODAY()
			    )
			
			VAR EsPeriodoFuturo =
			    FechaMinContexto > TODAY()
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    ModoSeleccionado = "Si" && EsPeriodoFuturo,
			        BLANK(),
			
			    ModoSeleccionado = "Si",
			        CALCULATE(
			            [Ventas Netas ERP],
			            DATESBETWEEN(
			                Calendario[Date],
			                EDATE(FechaMinContexto, -12),
			                EDATE(FechaMaxLimitada, -12)
			            )
			        ),
			
			    ModoSeleccionado = "No",
			        CALCULATE(
			            [Ventas Netas ERP],
			            DATEADD(
			                Calendario[Date],
			                -1,
			                YEAR
			            )
			        )
			)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: fe38dc4d-fa56-4839-a01c-16486f5ed36a

	measure 'Unidades LY Dinámico' =
			
			VAR ModoSeleccionado =
			    SELECTEDVALUE('Modo Comparación'[Modo], "No")
			
			VAR FechaMinSeleccionada =
			    MIN(Calendario[Date])
			
			VAR FechaMaxSeleccionada =
			    MAX(Calendario[Date])
			
			VAR FechaMaxActualLimitada =
			    MIN(FechaMaxSeleccionada, TODAY())
			
			VAR FechaInicioAA =
			    EDATE(FechaMinSeleccionada, -12)
			
			VAR FechaFinAA =
			    EDATE(FechaMaxActualLimitada, -12)
			
			VAR FechaInicioAACompleto =
			    DATE(YEAR(FechaMinSeleccionada) - 1, 1, 1)
			
			VAR FechaFinAACompleto =
			    DATE(YEAR(FechaMinSeleccionada) - 1, 12, 31)
			
			RETURN
			SWITCH(
			    ModoSeleccionado,
			
			    "Si",
			        CALCULATE(
			            [Unidadesd],
			            DATESBETWEEN(
			                Calendario[Date],
			                FechaInicioAA,
			                FechaFinAA
			            )
			        ),
			
			    "No",
			        CALCULATE(
			            [Unidadesd],
			            DATESBETWEEN(
			                Calendario[Date],
			                FechaInicioAACompleto,
			                FechaFinAACompleto
			            )
			        )
			)
		lineageTag: 652cffa4-93fb-4f7f-b30e-af228a09a113

		annotation PBI_FormatHint = {"isGeneralNumber":true}

