	partition Productos = m
		mode: import
		source =
				let
				    Origen = Sql.Database("192.168.0.10", "dat1", [Query="SELECT #(lf)referencia,#(lf)descrip,#(lf)idfamilia,#(lf)idSubFam,#(lf)idSubSubFam,#(lf)idGrupo,#(lf)idSubGrupo,#(lf)idMarca,#(lf)idSeccion,#(lf)idprov,#(lf)preciov,#(lf)precioc#(lf)FROM producto#(lf)WHERE referencia NOT LIKE '%(NO)%'#(lf)AND  referencia NOT LIKE '%(N)%'#(lf)AND  referencia NOT LIKE '%(NN)%'#(lf)AND  referencia NOT LIKE '%(NNN)%'"])
				in
				    Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

