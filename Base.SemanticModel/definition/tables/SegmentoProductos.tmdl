table SegmentoProductos
	lineageTag: f7bff242-346f-4d92-ba80-91dab9a781d6

	column referencia
		lineageTag: 74f88d27-7e8d-4c83-9c8a-820bfa452328
		summarizeBy: none
		isNameInferred
		sourceColumn: [referencia]

		annotation SummarizationSetBy = Automatic

	partition SegmentoProductos = calculated
		mode: import
		source =
				
				DISTINCT(
				    UNION(
				        -- referencias de proveedores
				        SELECTCOLUMNS(
				            FILTER(
				                ALL(Productos),
				                Productos[idprov] IN {816, 943,908,1212}
				            ),
				            "referencia", Productos[referencia]
				        ),
				
				        -- referencias adicionales (una por fila)
				        DATATABLE(
				            "referencia", STRING,
				            {
