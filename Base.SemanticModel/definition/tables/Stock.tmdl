	partition Stock = m
		mode: import
		source =
				let
				    Origen = Sql.Database("192.168.0.10", "dat1", [Query="WITH UltimaCompra AS (#(lf)    SELECT#(lf)        LAC.referencia,#(lf)        LAC.precio,#(lf)#(tab)#(tab)LAC.dto,#(lf)#(tab)#(tab)LAC.dtoPor2,#(lf)#(tab)#(tab)LAC.dtoMoneda,#(lf)#(tab)#(tab)LAC.pCoste,#(lf)        LAC.modo,#(lf)        AC.fechaAlb,#(lf)        AC.idAlb,#(lf)        AC.idSAlb,#(lf)#(tab)#(tab)AC.nota,#(lf)        ROW_NUMBER() OVER (#(lf)#(tab)#(tab)PARTITION BY LAC.referencia#(lf)#(tab)#(tab)ORDER BY #(lf)#(tab)#(tab)#(tab)AC.fechaAlb DESC,#(lf)#(tab)#(tab)#(tab)AC.idAlb DESC,#(lf)#(tab)#(tab)#(tab)LAC.numLinea DESC#(lf)#(lf)        ) AS rn#(lf)    FROM p_lineaAlbaran LAC#(lf)    INNER JOIN p_albaran AC#(lf)        ON AC.idAlb = LAC.idAlb#(lf)       AND AC.idSAlb = LAC.idSAlb#(lf)    WHERE LAC.pCoste > 0#(lf)      AND LAC.cantidad > 0#(lf)      AND AC.idSAlb = 'V'#(lf)),#(lf)#(lf)Stock AS (#(lf)    SELECT#(lf)        referencia,#(lf)        STRING_AGG(CAST(idAlmacen AS varchar), ',')#(lf)        WITHIN GROUP (ORDER BY idAlmacen) AS Almacenes,#(lf)        SUM(cant)   AS StockUds,#(lf)        SUM(cantKg) AS StockK,#(lf)        SUM(cajas)  AS StockC#(lf)    FROM lineasAlmacen#(lf)    WHERE idAlmacen IN (10,30,60,2000)#(lf)    GROUP BY referencia#(lf)),#(lf)#(lf)Venta AS(#(lf)#(tab)SELECT#(lf)#(tab)    LA.referencia,#(lf)#(tab)    COUNT(DISTINCT LA.idAlb) AS Repeticiones,#(lf)#(tab)    SUM(LA.cantKg) AS KilosVendidos,#(lf)#(lf)#(tab)    SUM(#(lf)#(tab)        CASE#(lf)#(tab)            WHEN LA.modo = 'U' THEN LA.cantidad#(lf)#(tab)            WHEN LA.modo = 'C' THEN LA.cantidad * LA.cUni#(lf)#(tab)            ELSE 0#(lf)#(tab)        END#(lf)#(tab)    ) AS UnidadesVendidas,#(lf)#(tab)#(tab)SUM(LA.total) AS ImporteVenta#(lf)#(tab)#(tab)#(lf)#(tab)FROM lineaAlbaran LA#(lf)#(tab)JOIN albaran A #(lf)#(tab)    ON LA.idAlb = A.idAlb #(lf)#(tab)   AND LA.idSAlb = A.idSAlb#(lf)#(tab)WHERE A.idsAlb IN ('V','AB','MU')#(lf)#(tab)  AND A.fechaAlb >= DATEADD(DAY,-90,CAST(GETDATE() AS DATE))#(lf)#(tab)GROUP BY LA.referencia#(lf))#(lf)#(lf)SELECT#(lf)    P.referencia,#(lf)    P.descrip,#(lf)#(tab)P.idprov,#(lf)#(tab)PV.nomCom,#(lf)#(tab)PV.razSoc,#(lf)    P.idFamilia,#(lf)    F.descrip AS Familia,#(lf)    P.idSubFam,#(lf)    LS.descrip AS SubFamilia,#(lf)    P.idMarca,#(lf)    M.descrip AS Marca,#(lf)    P.formato,#(lf)#(lf)    S.Almacenes,#(lf)    ISNULL(S.StockUds,0) AS StockUds,#(lf)    ISNULL(S.StockK,0) AS StockK,#(lf)    ISNULL(S.StockC,0) AS StockC,#(lf)#(tab)P.precioc AS PrecioCompraConfigurado,#(lf)#(tab)P.preciov AS PrecioVentaConfigurado,#(lf)#(tab)UC.pCoste AS PrecioCoste,#(lf)#(tab)UC.precio AS UltimoCoste,#(lf)#(tab)UC.dto,#(lf)#(tab)UC.dtoPor2,#(lf)#(tab)UC.dtoMoneda,#(lf)    UC.fechaAlb AS FechaUltimaCompra,#(lf)    UC.idAlb,#(lf)    UC.idSAlb,#(lf)    CASE#(lf)        WHEN P.formato = 'C' AND P.referencia NOT IN ('13PUL90', '13PUL92', '13PUL94', '13PUL95') THEN P.precioc * ISNULL(S.StockC,0)#(lf)        WHEN P.formato = 'K' THEN P.precioc * ISNULL(S.StockK,0)#(lf)        WHEN P.formato = 'U' THEN P.precioc * ISNULL(S.StockUds,0)#(lf)#(tab)#(tab) WHEN P.formato = 'C' AND P.referencia IN ('13PUL90', '13PUL92', '13PUL94', '13PUL95') THEN P.precioc * ISNULL(S.StockUds,0)#(lf)        ELSE 0#(lf)    END AS Inmovilizado,#(lf)#(tab)UC.nota,#(lf)#(tab)V.referencia,#(lf)#(tab)V.Repeticiones,#(lf)#(tab)V.UnidadesVendidas,#(lf)#(tab)V.KilosVendidos,#(lf)#(tab)V.ImporteVenta#(lf)FROM producto P#(lf)#(lf)LEFT JOIN Stock S#(lf)    ON S.referencia = P.referencia#(lf)#(lf)LEFT JOIN UltimaCompra UC#(lf)    ON UC.referencia = P.referencia#(lf)    AND UC.rn = 1#(lf)#(lf)LEFT JOIN Familia F#(lf)    ON P.idFamilia = F.idFamilia#(lf)#(lf)LEFT JOIN (#(lf)    SELECT DISTINCT idSubFamilia, descrip#(lf)    FROM lineasSubFamColeccion#(lf)) LS#(lf)#(lf)ON P.idSubFam = LS.idSubFamilia#(lf)#(lf)LEFT JOIN Marcas M#(lf)    ON P.idMarca = M.idMarca#(lf)LEFT JOIN proveedor PV#(lf)    ON P.idprov = PV.idProveedor#(lf)LEFT JOIN Venta V#(lf)    ON P.referencia = V.referencia#(lf)Where P.descrip NOT LIKE '(N%' AND (StockK <> 0 OR StockC <> 0 OR StockUds <> 0 OR V.UnidadesVendidas IS NOT NULL) #(lf)ORDER BY Inmovilizado DESC;"])
				in
				    Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

