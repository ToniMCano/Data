	column 'Nombre Cliente Factura' =
			
			LOOKUPVALUE(
			    Clientes[nomCom],
			    Clientes[idCliente],
			    Facturas[idCliente]
			)
		lineageTag: 9762d24e-fe54-4e5f-9cfb-832ce93bfdc9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Facturas = m
		mode: import
		source =
				let
				    Origen = Sql.Database("192.168.0.10", "dat1", [Query="SELECT#(lf)    F.idSFac,#(lf)    F.idFactura,#(lf)    CONCAT(F.idSFac, '-', F.idFactura) AS FacturaKey,#(lf)    F.fecha,#(lf)    F.totalBI,#(lf)    F.totalDto,#(lf)    F.tMonDto,#(lf)    F.dto,#(lf)    F.dtoFac1,#(lf)    F.dtoFac2,#(lf)    F.dtoFac3,#(lf)#(tab)F.idCliente#(lf)FROM factura F#(lf)WHERE F.fecha >= '20240101'#(lf)"]),
				    #"Filas ordenadas" = Table.Sort(Origen,{{"totalDto", Order.Descending}})
				in
				    #"Filas ordenadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

