	partition LineasPedido = m
		mode: import
		source =
				let
				    Origen = Sql.Database("192.168.0.10", "dat1", [Query="SELECT #(lf)CONCAT(L.idSAlb, '-',L.idAlb) AS PedidoKey,#(lf)L.idSAlb AS idSPedido,#(lf)L.idAlb AS idPedido,#(lf)L.descrip,#(lf)L.modo,#(lf)L.observa,#(lf)L.referencia,#(lf)L.idTarifa,#(lf)L.tipoLin, #(lf)L.numLinea,#(lf)L.idProRegGlo,#(lf)L.numLinPri,#(lf)L.idPromo,#(lf)L.saux1,#(lf)L.precio,#(lf)L.cUni,#(lf)L.cantidad,#(lf)L.dto,#(lf)L.total,#(lf)L.multiplicadorCantidadPedido,#(lf)L.multiplicadorKilosPedido,#(lf)L.cantKg#(lf)FROM LineaPedido L #(lf)JOIN Pedido P#(lf)    ON L.idAlb = P.idAlb#(lf)   AND L.idSAlb = P.idSAlb#(lf)WHERE P.fechaTomaAlb >= '20240101'"]),
				    #"Filas ordenadas" = Table.Sort(Origen,{{"idPedido", Order.Descending}})
				in
				    #"Filas ordenadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

