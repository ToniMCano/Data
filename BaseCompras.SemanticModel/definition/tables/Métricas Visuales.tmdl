table 'Métricas Visuales'
	lineageTag: 22358215-c381-42fc-b71e-62fa733b3b19

	measure 'Color MA/C' =
			
			VAR ValorActual = [MA/C]
			VAR ValorEmpresa = [MA/C Empresa Grupo]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(ValorActual) || ISBLANK(ValorEmpresa), "#808080",
			    ValorActual < ValorEmpresa * 0.8, "#C0392B",
			    ValorActual < ValorEmpresa, "#BA7517",
			    ValorActual >= ValorEmpresa, "#1D9E75"
			)
		lineageTag: 6bda06af-c6b4-4122-bfb0-ebe5de446895

	measure 'Color Media Albarán' =
			
			VAR ValorActual = [Media Albarán]
			VAR ValorEmpresa = [Media Albarán Empresa Grupo]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(ValorActual) || ISBLANK(ValorEmpresa), "#808080",
