			)
		lineageTag: a632cd44-2ed6-4616-8759-046b01874a30

	measure 'Color Referencias Distintas Comercial' =
			
			VAR ValorActual = [Referencias Distintas]
			VAR ValorEmpresa = [Media Referencias Distintas por Comercial Grupo]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(ValorActual) || ISBLANK(ValorEmpresa), "#808080",
			    ValorActual < ValorEmpresa * 0.8, "#C0392B",
			    ValorActual < ValorEmpresa, "#BA7517"
			)
		lineageTag: 4971adb7-ec14-462c-bf11-226b7fe3126e

	measure 'Color Media Referencias' =
			
			VAR Refs = [Referencias Distintas]
			VAR RefsAA = [Referencias Distintas AA]
			VAR MediaGrupo = [Media Refs Cliente Grupo Activos]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    ISBLANK(Refs) || ISBLANK(RefsAA) || ISBLANK(MediaGrupo),
			        "#000000",
			
			    Refs < RefsAA
			        && Refs < MediaGrupo,
			        "#D64550",      -- Rojo
			
			    Refs > RefsAA
			        && Refs < MediaGrupo,
			        "#B87333",      -- Cobre
			
			    Refs > RefsAA
			        && Refs >= MediaGrupo * 0.8,
			        "#2E8B57",      -- Verde
			
			    "#000000"           -- Negro
			)
		lineageTag: 101d9a60-aabd-4827-a36a-777a00f84c07

	measure '*Filtro Ventas y Ventas AA con dato' =
			
			VAR VentasActual =
			    [Ventas Netas ERP]
			VAR VentasAA =
			    [Ventas Netas LY]
			RETURN
			IF(
			     ISBLANK(VentasActual)
			        &&  ISBLANK(VentasAA),
			    1,
			    0
			)
		formatString: 0
		lineageTag: 7764bbcf-f862-49ff-aa24-82e0f94d633e

	measure 'Color Estado Venta' =
			
			
			VAR Indicador = [Indicador Compra]
			VAR Frecuencia = [Frecuencia Compra Días]
			
			RETURN
			 SWITCH(
			        TRUE(),
			        Indicador < Frecuencia, "#1D9E75",
			        Indicador > Frecuencia, "#C0392B ",
			        "black"
			    )
		lineageTag: 5cdcf112-6faf-4e96-a379-ec69bd171f9e

	measure 'Media Albarán Empresa Grupo Color Matriz' =
			
			VAR Grupo =
			    SELECTCOLUMNS(
			        ALL(GrupoComerciales[idEmpleado]),
			        "Value", GrupoComerciales[idEmpleado]
			    )
			
			VAR ImporteGrupo =
			    CALCULATE(
			        [DtoAlbAplicado Final],
			
			        -- Ignora el cliente concreto de la fila
			        REMOVEFILTERS(Clientes),
			
			        -- Ignora filtros de comercial
			        REMOVEFILTERS(FactVentas[idEmpleado]),
			        REMOVEFILTERS(Empleado),
			
			        FactVentas[idSAlb] = "V",
			
			        TREATAS(
			            Grupo,
			            FactVentas[idEmpleado]
			        )
			    )
			
			VAR AlbaranesGrupo =
			    CALCULATE(
			        DISTINCTCOUNT(FactVentas[idAlb]),
			
			        -- Ignora el cliente concreto de la fila
			        REMOVEFILTERS(Clientes),
			
			        -- Ignora filtros de comercial
			        REMOVEFILTERS(FactVentas[idEmpleado]),
			        REMOVEFILTERS(Empleado),
			
			        FactVentas[idSAlb] = "V",
			
			        TREATAS(
			            Grupo,
			            FactVentas[idEmpleado]
			        )
			    )
			
			RETURN
			DIVIDE(
			    ImporteGrupo,
			    AlbaranesGrupo
			)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 9cf39ea5-56f2-46f6-ad8e-0425b777ad36

	measure 'Media Albaran Empresa Grupo Matriz (Importe)%' =
			
			
			DIVIDE(
			    [Media Albarán] - [Media Albarán Empresa Grupo Color Matriz], [Media Albarán Empresa Grupo Color Matriz]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d37519bf-fe11-4bf9-9ee3-6b9293f6f86f

	measure 'TEST Media Albaran Empresa Grupo Matriz (Importe)%' = ```
			
			VAR resultado =
			DIVIDE(
			    [Media Albarán] -[Media Albarán Empresa Grupo Color Matriz], [Media Albarán Empresa Grupo Color Matriz]
			)
			
			RETURN
			resultado 
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: e745538f-2839-4645-a2b3-71560065fc42

